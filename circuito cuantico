from qiskit import QuantumCircuit
from qiskit_ionq import IonQProvider
import os

def create_qaoa_jssp_circuit():
    """
    Crea el circuito QAOA para el problema de manufactura flexible (JSSP)
    de forma nativa, evitando el uso del módulo obsoleto qiskit.opflow.
    """
    # 2 cúbits para representar las prioridades de procesamiento en el horno
    num_qubits = 2
    qc = QuantumCircuit(num_qubits, num_qubits)
    
    # 1. Preparación del estado inicial (Superposición equitativa)
    qc.h(range(num_qubits))
    
    # Parámetros de optimización y coeficientes de costo industrial
    gamma = 0.4
    beta = 0.2
    coeff_zz = 2.5  # Penalización alta por conflicto simultáneo en el horno
    coeff_zi = 1.2  # Costo térmico / de retraso de la Pieza A
    coeff_iz = 0.8  # Costo térmico / de retraso de la Pieza B
    
    # 2. Mezclador de Costos (Cost Unitary / Simulación del Hamiltoniano JSSP)
    # Término ZZ (Interacción crítica / Conflicto de uso del horno industrial)
    qc.cx(0, 1)
    qc.rz(2 * gamma * coeff_zz, 1)
    qc.cx(0, 1)
    
    # Términos individuales de costo (Z en cada cúbit)
    qc.rz(2 * gamma * coeff_zi, 0)
    qc.rz(2 * gamma * coeff_iz, 1)
    
    # 3. Mezclador de Transición (Mixer Unitary - Rotaciones X)
    for i in range(num_qubits):
        qc.rx(2 * beta, i)
        
    # 4. Medición final
    qc.measure(range(num_qubits), range(num_qubits))
    
    return qc

# Generar el circuito JSSP
qc_jssp = create_qaoa_jssp_circuit()

# Configuración del Backend de IonQ Aria 1
API_KEY = os.getenv("IONQ_API_KEY", "TU_API_KEY_DE_QOLLAB_O_IONQ")
provider = IonQProvider(token=API_KEY)
backend = provider.get_backend("ionq_simulator") # O el backend QPU asignado en Qollab

# Ejecución en el motor de Aria 1
shots = 1024
print("Enviando circuito JSSP optimizado a Aria 1...")
job = backend.run(qc_jssp, shots=shots)
result = job.result()
counts_jssp = result.get_counts(qc_jssp)

print("\nResultados (JSSP Manufactura):", counts_jssp)
